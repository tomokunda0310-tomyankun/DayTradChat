<?xml version="1.0" encoding="utf-8"?>
<!-- ver 2.16-14b -->
<!-- app/src/main/res/layout/fragment_display_symbols.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="現在表示（ダブルタップで削除）"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="受信順に表示します。日経平均は固定です。"
        android:textSize="9sp" />

    <ListView
        android:id="@+id/listSelectedCodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonUndoRemove"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="戻す"
            android:textSize="10sp" />

        <Button
            android:id="@+id/buttonResetDisplay"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="削除を全解除"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
