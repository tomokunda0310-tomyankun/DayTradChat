<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/item_signal_grid.xml -->
<!--  ver 1.13-02 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSignal"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    android:layout_margin="4dp"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/textCodeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="7203 トヨタ自動車"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="2875.0"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textDelta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="前回差 +12.5"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textSub1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="変化率 -1.88% / score -6"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/textSub2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="VWAP下 / 売り板優勢 / 下落強い"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/textUpdatedAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="12:30:52"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />
</LinearLayout>
