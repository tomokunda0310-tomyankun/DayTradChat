<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/item_signal_grid.xml -->
<!-- ver 2.13-04 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSignal"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:layout_margin="4dp"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/textCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="7203"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="トヨタ自動車"
        android:textColor="@color/text_primary"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/textPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="2875.0"
        android:textColor="@color/text_primary"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textDelta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="前日比 0.0%"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSub1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="score 0"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/textSub2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="VWAP下 / 売り板優勢 / 下落強い"
        android:textColor="@color/text_secondary"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/textUpdatedAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:text="12:30:52"
        android:textColor="@color/text_secondary"
        android:textSize="9sp" />
</LinearLayout>