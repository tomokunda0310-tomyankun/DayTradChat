<?xml version="1.0" encoding="utf-8"?>
<!-- ver 2.18-01 -->
<!-- app/src/main/res/layout/item_signal_grid.xml -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSignal"
    android:layout_width="match_parent"
    android:layout_height="102dp"
    android:layout_margin="2dp"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="3dp">

    <!-- ★ textCode + trend アイコンをまとめた行 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="402A"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- ★ トレンド矢印（追加） -->
        <ImageView
            android:id="@+id/iconTrend"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="1dp"
            android:visibility="invisible"
            android:src="@drawable/ic_trend_up" />

    </RelativeLayout>

    <TextView
        android:id="@+id/textName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="アクセルスペース"
        android:textSize="6sp" />

    <TextView
        android:id="@+id/textPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:text="707"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textDelta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="前日比 0.0%"
        android:textSize="6sp" />

    <TextView
        android:id="@+id/textSub1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="score 11"
        android:textSize="6sp" />

    <TextView
        android:id="@+id/textSub2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="ロング候補"
        android:textSize="6sp" />

    <TextView
        android:id="@+id/textProfit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textUpdatedAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="13:16:01"
        android:textSize="6sp" />

</LinearLayout>
