<?xml version="1.0" encoding="utf-8"?>
<!-- ver 2.16-00 -->
<!-- app/src/main/res/layout/fragment_settings.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/textVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ver 2.16-00"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="サーバIP / ホスト"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editHost"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="自動再接続時間（秒）"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editReconnectSec"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:inputType="number"
            android:textSize="11sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/textPort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Port: 5001"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSaveReconnect"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="保存して再接続"
                android:textSize="10sp"
                android:maxLines="1" />

            <Button
                android:id="@+id/buttonReset"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="初期値に戻す"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="サーバ送信（銘柄入替）"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerTargetCode"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/editSendCode"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:hint="新コード or watch_codes文字列"
            android:textSize="11sp"
            android:padding="8dp" />

        <Button
            android:id="@+id/buttonSendWatch"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:text="送信"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/textSendSpec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="9sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="保有情報"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerHoldingCode"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp" />

        <Spinner
            android:id="@+id/spinnerHoldingShares"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/editBuyPrice"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:inputType="numberDecimal"
            android:hint="取得単価"
            android:textSize="11sp"
            android:padding="8dp" />

        <Button
            android:id="@+id/buttonApplyHolding"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:text="投入"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>
</ScrollView>
