<?xml version="1.0" encoding="utf-8"?>
<!-- ver 2.16-10 -->
<!-- app/src/main/res/layout/fragment_settings.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/textVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ver 2.16-10"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="ホスト"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/editHostInline"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:padding="6dp"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/textPortInline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="port: 5001"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="再接続"
                android:textSize="10sp" />

            <Spinner
                android:id="@+id/spinnerReconnectSec"
                android:layout_width="70dp"
                android:layout_height="36dp" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="秒"
                android:textSize="10sp" />

            <Button
                android:id="@+id/buttonSaveReconnect"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="保存して再接続"
                android:textSize="9sp" />

            <Button
                android:id="@+id/buttonReset"
                android:layout_width="110dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="初期値に戻す"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="サーバ送信（銘柄入替）"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerTargetCode"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/editSendCode"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:hint="新コード or watch_codes文字列"
            android:padding="6dp"
            android:textSize="10sp" />

        <Button
            android:id="@+id/buttonSendWatch"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="送信"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保有情報"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerHoldingCode"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerHoldingShares"
                android:layout_width="90dp"
                android:layout_height="36dp" />

            <EditText
                android:id="@+id/editBuyPrice"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="取得単価"
                android:inputType="numberDecimal"
                android:padding="6dp"
                android:textSize="10sp" />

            <Button
                android:id="@+id/buttonApplyHolding"
                android:layout_width="86dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="投入"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
